{
    "services": {
        "check_device_online": {
            "name": "Check Device Online Status",
            "description": "Checks if a specific smart home device is currently online and reachable on the network.",
            "fields": {
                "device_name": {
                    "required": true,
                    "type": "string",
                    "description": "The exact name of the device to check (e.g. 'Living Room Lamp')."
                }
            }
        },

        "search": {
            "name": "Local & Web RAG Search",
            "description": "RAG tool for local & web search. Performs best when given a comprehensive search-optimized query.",
            "fields": {
                "query": {
                    "required": true,
                    "type": "string"
                }
            }
        },
        "wol_turn_on_tv": {
            "name": "WOL Turn On TV",
            "description": "Sends a 'magic packet' to wake up a TV with 'Wake-On-LAN' capabilities.",
            "fields": {
                "mac_address": {
                    "required": true,
                    "default": "a4:36:c7:58:3f:18",
                    "type": "string"
                },
                "target_ip": {
                    "default": "192.168.1.142",
                    "type": "string"
                },
                "port": {
                    "default": 9,
                    "type": "integer"
                }
            }
        },
        "lg_webos_tv_turn_on": {
            "name": "LG WebOS TV Turn On",
            "description": "Turns on an LG WebOS TV.",
            "fields": {
                "mac_address": {
                    "required": true,
                    "default": "a4:36:c7:58:3f:18",
                    "type": "string"
                },
                "target_ip": {
                    "default": "192.168.1.142",
                    "type": "string"
                },
                "port": {
                    "default": 9,
                    "type": "integer"
                }
            }
        },
        "lg_webos_tv_turn_off": {
            "name": "LG WebOS TV Turn Off",
            "description": "Turns off an LG WebOS TV.",
            "fields": {
                "ip_address": {
                    "default": "192.168.1.142",
                    "type": "string"
                }
            }
        },
        "lamp_turn_on": {
            "name": "Lamp Turn On",
            "description": "Turns on a Govee lamp.",
            "fields": {}
        },
        "lamp_turn_off": {
            "name": "Lamp Turn Off",
            "description": "Turns off a Govee lamp.",
            "fields": {}
        },
        "set_lamp_brightness": {
            "name": "Set Lamp Brightness",
            "description": "Sets the brightness of a Govee lamp.",
            "fields": {
                "brightness": {
                    "required": true,
                    "default": 100,
                    "type": "integer"
                }
            }
        },
        "set_lamp_color": {
            "name": "Set Lamp Color",
            "description": "Sets the color of a Govee lamp.",
            "fields": {
                "red": {
                    "required": true,
                    "example": 255,
                    "type": "integer"
                },
                "green": {
                    "required": true,
                    "example": 255,
                    "type": "integer"
                },
                "blue": {
                    "required": true,
                    "example": 255,
                    "type": "integer"
                }
            }
        },
        "set_lamp_temperature": {
            "name": "Set Lamp Temperature",
            "description": "Sets the temperature of a Govee lamp.",
            "fields": {
                "temperature": {
                    "required": true,
                    "default": 2700,
                    "type": "integer"
                }
            }
        },
        "set_lamp_scene": {
            "name": "Set Lamp Scene",
            "description": "Sets the scene of a Govee lamp.",
            "fields": {
                "scene": {
                    "required": true,
                    "type": "string",
                    "enum": [
                        "sunrise",
                        "sunset",
                        "movie",
                        "dating",
                        "romantic",
                        "twinkle",
                        "candlelight",
                        "snowflake",
                        "energetic",
                        "breathe",
                        "crossing"
                    ]
                }
            }
        },
        "plug_turn_on": {
            "name": "Plug Turn On",
            "description": "Turns on a Kasa plug.",
            "fields": {
                "ip_address": {
                    "required": true,
                    "type": "string",
                    "description": "The IP address of the plug"
                }
            }
        },
        "plug_turn_off": {
            "name": "Plug Turn Off",
            "description": "Turns off a Kasa plug.",
            "fields": {
                "ip_address": {
                    "required": true,
                    "type": "string",
                    "description": "The IP address of the plug"
                }
            }
        },
        "bulb_turn_on": {
            "name": "Bulb Turn On",
            "description": "Turns on a Kasa bulb.",
            "fields": {
                "ip_address": {
                    "required": true,
                    "type": "string",
                    "description": "The IP address of the bulb"
                }
            }
        },
        "bulb_turn_off": {
            "name": "Bulb Turn Off",
            "description": "Turns off a Kasa bulb.",
            "fields": {
                "ip_address": {
                    "required": true,
                    "type": "string",
                    "description": "The IP address of the bulb"
                }
            }
        },
        "set_bulb_brightness": {
            "name": "Set Bulb Brightness",
            "description": "Sets the brightness of a Kasa bulb.",
            "fields": {
                "ip_address": {
                    "required": true,
                    "type": "string",
                    "description": "The IP address of the bulb"
                },
                "brightness": {
                    "required": true,
                    "default": 100,
                    "type": "integer"
                }
            }
        },
        "set_bulb_color": {
            "name": "Set Lamp Color",
            "description": "Sets the color of a Kasa bulb.",
            "fields": {
                "ip_address": {
                    "required": true,
                    "type": "string",
                    "description": "The IP address of the bulb"
                },
                "hue": {
                    "required": true,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 360
                },
                "saturation": {
                    "required": true,
                    "default": 100,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "value": {
                    "required": true,
                    "default": 100,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                }
            }
        }
    }
}