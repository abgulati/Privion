{
    "services": {

        "search": {
            "name": "Local & Web RAG Search",
            "description": "Unified RAG tool for local (documents) & web (search engine) search. Performs best when given a detailed and comprehensive, yet focused search-optimized query encompassing all relevant information from the conversational context.  When detailed information is needed from a specific URL (other than internal 'http://llm-citations-database.net' addresses), use the 'fetch_url' tool with the URL to retrieve the full article content.",
            "fields": {
                "query": {
                    "required": true,
                    "type": "string"
                },
                "category": {
                    "required": false,
                    "type": "string",
                    "enum": [
                        "general",
                        "news",
                        "images",
                        "videos",
                        "music",
                        "it",
                        "science",
                        "files",
                        "social_media"
                    ],
                    "default": "web"
                }
            }
        },

        "fetch_url": {
            "name": "Fetch Webpage Content",
            "description": "Fetches and extracts the main text content from a given URL. Use this when you need to read the full contents of a webpage, such as after finding relevant URLs from a search. DOES NOT WORK FOR 'http://llm-citations-database.net' ADDRESSES!",
            "fields": {
                "url": {
                    "required": true,
                    "type": "string",
                    "description": "The full URL of the webpage to fetch and extract content from (DOES NOT WORK FOR 'http://llm-citations-database.net' ADDRESSES!)"
                }
            }
        },
        
        "wol_turn_on_tv": {
            "name": "WOL Turn On TV",
            "description": "Sends a 'magic packet' to wake up a TV with 'Wake-On-LAN' capabilities.",
            "fields": {
                "mac_address": {
                    "required": true,
                    "default": "a4:36:c7:58:3f:18",
                    "type": "string"
                },
                "target_ip": {
                    "default": "192.168.1.142",
                    "type": "string"
                },
                "port": {
                    "default": 9,
                    "type": "integer"
                }
            }
        },

        "lg_webos_tv_turn_on": {
            "name": "LG WebOS TV Turn On",
            "description": "Turns on an LG WebOS TV.",
            "fields": {
                "mac_address": {
                    "required": true,
                    "default": "a4:36:c7:58:3f:18",
                    "type": "string"
                },
                "target_ip": {
                    "default": "192.168.1.142",
                    "type": "string"
                },
                "port": {
                    "default": 9,
                    "type": "integer"
                }
            }
        },

        "lg_webos_tv_turn_off": {
            "name": "LG WebOS TV Turn Off",
            "description": "Turns off an LG WebOS TV.",
            "fields": {
                "ip_address": {
                    "default": "192.168.1.142",
                    "type": "string"
                }
            }
        },

        "lamp_turn_on": {
            "name": "Lamp Turn On",
            "description": "Turns on a Govee lamp.",
            "fields": {
            }
        },
        
        "lamp_turn_off": {
            "name": "Lamp Turn Off",
            "description": "Turns off a Govee lamp.",
            "fields": {
            }
        },

        "set_lamp_brightness": {
            "name": "Set Lamp Brightness",
            "description": "Sets the brightness of a Govee lamp.",
            "fields": {
                "brightness": {
                    "required": true,
                    "default": 100,
                    "type": "integer"
                }
            }
        },

        "set_lamp_color": {
            "name": "Set Lamp Color",
            "description": "Sets the color of a Govee lamp.",
            "fields": {
                "red": {
                    "required": true,
                    "example": 255,
                    "type": "integer"
                },
                "green": {
                    "required": true,
                    "example": 255,
                    "type": "integer"
                },
                "blue": {
                    "required": true,
                    "example": 255,
                    "type": "integer"
                }
            }
        },

        "set_lamp_temperature": {
            "name": "Set Lamp Temperature",
            "description": "Sets the temperature of a Govee lamp.",
            "fields": {
                "temperature": {
                    "required": true,
                    "default": 2700,
                    "type": "integer"
                }
            }
        },

        "set_lamp_scene": {
            "name": "Set Lamp Scene",
            "description": "Sets the scene of a Govee lamp.",
            "fields": {
                "scene": {
                    "required": true,
                    "type": "string",
                    "enum": [
                        "sunrise",
                        "sunset",
                        "movie",
                        "dating",
                        "romantic",
                        "twinkle",
                        "candlelight",
                        "snowflake",
                        "energetic",
                        "breathe",
                        "crossing"
                    ]
                }
            }
        },

        "plug_turn_on": {
            "name": "Plug Turn On",
            "description": "Turns on a Kasa plug.",
            "fields": {
            }
        },
        "plug_turn_off": {
            "name": "Plug Turn Off",
            "description": "Turns off a Kasa plug.",
            "fields": {
            }
        },
        "bulb_turn_on": {
            "name": "Bulb Turn On",
            "description": "Turns on a Kasa bulb.",
            "fields": {}
        },
        "bulb_turn_off": {
            "name": "Bulb Turn Off",
            "description": "Turns off a Kasa bulb.",
            "fields": {}
        },
        "set_bulb_brightness": {
            "name": "Set Bulb Brightness",
            "description": "Sets the brightness of a Kasa bulb.",
            "fields": {
                "brightness": {
                    "required": true,
                    "default": 100,
                    "type": "integer"
                }
            }
        },
        "set_bulb_color": {
            "name": "Set Lamp Color",
            "description": "Sets the color of a Kasa bulb.",
            "fields": {
                "hue": {
                    "required": true,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 360
                },
                "saturation": {
                    "required": true,
                    "default": 100,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "value": {
                    "required": true,
                    "default": 100,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                }
            }
        }
    }
}