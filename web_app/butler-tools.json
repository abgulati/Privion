{
    "services": {
        
        "wol_turn_on_tv": {
            "name": "WOL Turn On TV",
            "description": "Sends a 'magic packet' to wake up a TV with 'Wake-On-LAN' capabilities.",
            "fields": {
                "mac_address": {
                    "required": true,
                    "example": "aa:bb:cc:dd:ee:ff"
                },
                "target_ip": {
                    "default": "255.255.255.255"
                },
                "port": {
                    "default": 9
                }
            }
        },

        "lg_webos_tv_turn_on": {
            "name": "LG WebOS TV Turn On",
            "description": "Turns on an LG WebOS TV.",
            "fields": {
                "mac_address": {
                    "required": true,
                    "example": "aa:bb:cc:dd:ee:ff"
                },
                "target_ip": {
                    "default": "255.255.255.255"
                },
                "port": {
                    "default": 9
                }
            }
        },

        "lg_webos_tv_turn_off": {
            "name": "LG WebOS TV Turn Off",
            "description": "Turns off an LG WebOS TV.",
            "fields": {
                "ip_address": {
                    "default": "None"
                }
            }
        },

        "lamp_turn_on": {
            "name": "Lamp Turn On",
            "description": "Turns on a Govee lamp.",
            "fields": {
            }
        },
        
        "lamp_turn_off": {
            "name": "Lamp Turn Off",
            "description": "Turns off a Govee lamp.",
            "fields": {
            }
        }
    }
}