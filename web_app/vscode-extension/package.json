{
    "name": "hf-waitress",
    "displayName": "HF Waitress - FIM, Chat and Edit",
    "description": "AI-powered code assistance",
    "version": "2.0.0",
    "publisher": "privion-extensions",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "hfw-fim.generateCompletion",
                "title": "Generate FIM Completion"
            },
            {
                "command": "hfw-fim.toggleAutoComplete",
                "title": "Toggle FIM Auto-Complete"
            }
        ],
        "configuration": {
            "title": "HF-Waitress FIM Completion",
            "properties": {
                "hfw-fim.serverUrl": {
                    "type": "string",
                    "default": "http://localhost:9069",
                    "description": "HF-Waitress URL"
                },
                "hfw-fim.host": {
                    "type": "string",
                    "default": "localhost",
                    "description": "HF-Waitress host"
                },
                "hfw-fim.port": {
                    "type": "number",
                    "default": 9069,
                    "description": "HF-Waitress port"
                },
                "hfw-fim.apiEndpoint": {
                    "type": "string",
                    "default": "/exl3_fim_stream",
                    "description": "HF-Waitress API endpoint"
                },
                "hfw-fim.maxTokens": {
                    "type": "number",
                    "default": 100,
                    "description": "Maximum tokens to generate"
                },
                "hfw-fim.temperature": {
                    "type": "number",
                    "default": 0.3,
                    "maximum": 2,
                    "description": "Sampling temperature"
                },
                "hfw-fim.autoComplete": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable automatic completions"
                },
                "hfw-fim.triggerDelay": {
                    "type": "number",
                    "default": 500,
                    "description": "Delay in milliseconds before triggering auto-complete"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.74.0",
        "@types/node": "^18.0.0",
        "typescript": "^4.9.4"
    },
    "author": "",
    "license": "ISC",
    "keywords": []
}
